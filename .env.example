PORT=8787

# Shared state for horizontal resolver deployments. When DATABASE_URL is unset,
# the resolver falls back to the local JSON store. REDIS_URL enables distributed
# rate limiting and disables in-process polling in favor of the queue worker.
# DATABASE_URL=postgresql://fiber_offers:change-me@127.0.0.1:54320/fiber_offers
# DATABASE_POOL_MAX=10
# REDIS_URL=redis://127.0.0.1:63790
# REDIS_KEY_PREFIX=fiber-offers
# RESOLVER_QUEUE_NAME=fiber-offers-maintenance

# With NODE_ENV=production the resolver refuses to start unless RESOLVER_API_KEY
# (24+ characters), RESOLVER_SECRET_ENCRYPTION_KEY (32+ characters),
# RESOLVER_PUBLIC_URL and DATABASE_URL are set to real values. `fiber-offers init`
# generates them. RESOLVER_ALLOW_JSON_STORE=true accepts running without a database.
#
# Optional outside production. Leave unset for open local demo mode.
# RESOLVER_API_KEY=change-me
# RESOLVER_ADMIN_SESSION_TTL_SECONDS=28800
# Public demos only. Serves the /demo routes (offers signed with a key the
# server generates, a sample webhook inbox) and lets anonymous readiness checks
# run route checks on the payer node. Never set this on a resolver that takes
# real payments.
# RESOLVER_DEMO_MODE=false
# Any visitor receives an operator session without the API key. Ignored unless
# RESOLVER_DEMO_MODE=true.
# RESOLVER_PUBLIC_OPERATOR_ACCESS=false
# Encrypts persisted webhook secrets with AES-256-GCM. Required for hosted deployments.
# RESOLVER_SECRET_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Private/localhost webhook targets default to disabled when NODE_ENV=production.
# When disabled, each delivery resolves the target and refuses any address that
# is not public, and redirects are never followed.
# RESOLVER_ALLOW_PRIVATE_WEBHOOKS=false
# RESOLVER_RATE_LIMIT_WINDOW_MS=60000
# RESOLVER_RATE_LIMIT_MAX=120
# The resolver's public address. When set, every link it returns uses this and
# no request header can change it. Set it for any deployment others can reach.
# RESOLVER_PUBLIC_URL=https://offers.merchant.example
# Number of reverse proxies in front of the resolver. Clients are identified by
# counting this many hops from the right of X-Forwarded-For. Leave at 0 when
# clients connect directly; a wrong value lets clients evade rate limits.
# RESOLVER_TRUSTED_PROXY_HOPS=0
# What to do when the rate limiter's store (Redis) is unreachable: true keeps
# serving requests unlimited, false answers 503.
# RESOLVER_RATE_LIMIT_FAIL_OPEN=true

FIBER_INVOICE_MODE=fiber-rpc
FIBER_RPC_URL=http://127.0.0.1:8227
FIBER_RPC_INVOICE_METHOD=new_invoice
FIBER_RPC_GET_INVOICE_METHOD=get_invoice
FIBER_RPC_PROBE_METHOD=node_info
# Network of the merchant node: mainnet, testnet, or dev. Leave unset on mainnet
# and testnet, where it is read from the node. Set it to "dev" for a private
# chain so offers signed for another network are refused at registration.
# FIBER_NETWORK=dev
# Token type scripts the resolver may mint invoices for, as a JSON array. An
# offer names a token only by the hash of its type script; the resolver needs
# the full script and checks that it hashes to the value in the offer. Exact
# scripts in the node's own UDT whitelist are picked up automatically.
# FIBER_UDT_SCRIPTS=[{"name":"USDI","code_hash":"0x...","hash_type":"type","args":"0x..."}]
# FIBER_UDT_SCRIPTS_FILE=/etc/fiber-offers/udt-scripts.json
# How long an issued invoice stays payable, in seconds. An invoice never outlives
# its offer's own expiry.
# FIBER_INVOICE_TTL_SECONDS=900
# Abort a Fiber RPC call that has not completed in this many milliseconds (0 disables).
# FIBER_RPC_TIMEOUT_MS=15000

# Docker defaults to a private bridge relay for an FNN bound to host loopback.
# FIBER_RPC_HOST=127.0.0.1
# FIBER_RPC_PORT=8227

# Optional basic auth if your Fiber RPC endpoint requires it.
# FIBER_RPC_USERNAME=
# FIBER_RPC_PASSWORD=
# Equivalent merchant-prefixed aliases are supported:
# MERCHANT_FIBER_RPC_URL=https://fiber-rpc.merchant.example
# MERCHANT_FIBER_RPC_USERNAME=
# MERCHANT_FIBER_RPC_PASSWORD=

# Live end-to-end check (npm run fiber:e2e-check). It starts its own resolver
# against the merchant node and pays through the SDK with the payer node.
# MERCHANT_FIBER_RPC_URL=http://127.0.0.1:8227
# PAYER_FIBER_RPC_URL=http://127.0.0.1:8229
# FIBER_E2E_AMOUNT=100000000
# FIBER_E2E_INVOICE_TTL=10
# FIBER_E2E_DRY_RUN_ONLY=true
# FIBER_E2E_TRAMPOLINE_HOPS=
# FIBER_E2E_MAX_FEE_AMOUNT=100000
# FIBER_E2E_MAX_FEE_RATE=

# Optional standalone payer route check.
# FIBER_INVOICE=fibt1...
# FIBER_ROUTE_TIMEOUT_SECONDS=60
# FIBER_ROUTE_TRAMPOLINE_HOPS=
# FIBER_ROUTE_MAX_FEE_AMOUNT=100000
# FIBER_ROUTE_MAX_FEE_RATE=

# Optional payer-to-merchant topology report.
# FIBER_TOPOLOGY_STRICT=false

# Optional guarded direct-channel fixture.
# The command is report-only unless FIBER_FIXTURE_OPEN_DIRECT_CHANNEL=true.
# FIBER_DIRECT_CHANNEL_FUNDING_AMOUNT=10000000000
# FIBER_MERCHANT_PEER_ADDRESS=/ip4/127.0.0.1/tcp/8228/p2p/...
# FIBER_DIRECT_CHANNEL_PUBLIC=false
# FIBER_DIRECT_CHANNEL_ONE_WAY=false
# FIBER_FIXTURE_OPEN_DIRECT_CHANNEL=false

# Resolver background workers and webhook delivery controls.
RESOLVER_WORKERS_ENABLED=true
RESOLVER_WORKERS_RUN_ON_START=true
# In a Redis deployment, run `npm run worker`; API replicas leave these false.
# RESOLVER_SETTLEMENT_SYNC_INTERVAL_MS=3000
# RESOLVER_WEBHOOK_RETRY_INTERVAL_MS=30000
# RESOLVER_WEBHOOK_MAX_ATTEMPTS=8
# RESOLVER_WEBHOOK_RETRY_MIN_AGE_MS=30000
# RESOLVER_WEBHOOK_TIMEOUT_MS=10000
